{
    "name": "AGCRN",
    "DEBUG": false,
    
    "model_path": "LSaved/AGCRN/models/0113_160232",
    
    "saved_dir": "result/AGCRN/pred",
    "log_dir": "TestLog",

    "n_gpu": 1,
    "loss": "mse_loss",
    "metrics": [
        "MAE",
        "RMSE",
        "MAPE",
        "Accuracy"
    ],
    "data_loader":{
        "type": "TerminalFlightMixDataLoader",
        "args":{
            "data_dir": "data/temp",
            "batch_size": 1,
            "n_his": 12,
            "n_pred": 6,
            "is_continous": true,
            "dates_dist": [["20240619", "20240620"]],
            "interval":5,
            "normalizer": "std",
            "shuffle": false,
            "validation_split": 0,
            "training": true
        }
    },
    "arch": {
        "type": "AGCRN",
        "args": {
            "num_nodes":10, 
            "input_dim": 7, 
            "hidden_dim": 64,
            "output_dim": 1, 
            "cheb_k": 2, 
            "embed_dim": 2, 
            "horizon": 6, // 即输出序列长度
            "num_layers": 2, 
            "default_graph": true
        }
    }
    
}