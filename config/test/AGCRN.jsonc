{
    "name": "AGCRN",
    "model_path": "LSaved/AGCRN/models/AGCRN/0108_141419",
    "saved_dir": "result/AGCRN/pred",
    "data_loader":{
        "type": "CrowdDataLoader",
        "args":{
            "data_dir": "data/temp",
            "batch_size": 1,
            "n_his": 12,
            "n_pred": 6,
            "is_continous": true,
            "dates_dist": [["20240619", "20240620"]],
            "interval":5,
            "shuffle": false,
            "validation_split": 0,
            "training": true
        }
    },
    "loss": "mse_with_regularizer_loss",
    "metrics": [
        "RMSE",
        "MAE",
        "MAPE",
        "Accuracy",
        "R2",
        "Explained_Variance"
    ],
    "trainer":{
        "save_dir": "LSaved/AGCRN",
    },
    "arch": {
        "type": "AGCRN",
        "args": {
            "num_nodes":10, 
            "input_dim": 7, 
            "hidden_dim": 64,
            "output_dim": 1, 
            "cheb_k": 2, 
            "embed_dim": 2, 
            "horizon": 6, // 即输出序列长度
            "num_layers": 2, 
            "default_graph": true
        }
    },
    "n_gpu": 1,
}