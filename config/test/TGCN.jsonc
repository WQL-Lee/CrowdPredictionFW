{
    "name": "TGCN",
    "DEBUG": true,
    "model_path": "LSaved/TGCN/cache/models",
    "saved_dir": "result/TGCN/pred",
    "data_loader":{
        "type": "TerminalDataLoader",
        "args":{
            "data_dir": "data/temp",
            "batch_size": 1,
            "n_his": 12,
            "n_pred": 6,
            "is_continous": true,
            "dates_dist": [["20240619", "20240620"]],
            "interval":5,
            "normalizer": "std",
            "shuffle": false,
            "validation_split": 0,
            "training": true
        }
    },
    "loss": "mse_with_regularizer_loss",
    "metrics": [
        "RMSE",
        "MAE",
        "MAPE",
        "Accuracy",
        "R2",
        "Explained_Variance"
    ],
    "trainer":{
        "save_dir": "LSaved/TGCN",
    },
    "arch": {
        "type": "TGCN",
        "args": {
            "adj_path": "data/temp/adj.csv",
            "num_nodes": 10,
            "hidden_dim": 256,
            "output_dim": 6
        }
    },
    "n_gpu": 1,
}