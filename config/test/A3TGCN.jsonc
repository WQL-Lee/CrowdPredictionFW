{
    "name": "A3TGCN",
    "DEBUG": false,
    
    "model_path": "LSaved/A3TGCN/models/0113_163423",
    
    "saved_dir": "result/A3TGCN/pred",
    "log_dir": "TestLog",

    "n_gpu": 1,
    "loss": "mse_with_regularizer_loss",
    "metrics": ["RMSE", "MAE", "MAPE", "Accuracy", "R2", "Explained_Variance"],
    "data_loader":{
        "type": "TerminalFlightMixDataLoader",
        "args":{
            "data_dir": "data/temp",
            "batch_size": 1,
            "n_his": 12,
            "n_pred": 6,
            "is_continous": true,
            "dates_dist": [["20240619", "20240620"]],
            "interval":5,
            "normalizer": "std",
            "shuffle": false,
            "validation_split": 0,
            "training": true
        }
    },
    "arch": {
        "type": "A3TGCN",
        "args": {
            "node_features": 7,
            "hidden_dim": 64,
            "output_dim": 6,
            "adj_path": "data/temp/adj.csv",
            "batch_size": 1
        }
    }
    
}