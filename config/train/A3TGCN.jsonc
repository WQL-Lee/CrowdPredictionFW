{
    "name": "A3TGCN",
    "n_gpu": 1,
    "DEBUG": false,
    "result_info": {
        "is_saved": true,
        "saved_dir": "result/A3TGCN/train"
    },
    "loss": "mse_with_regularizer_loss",
    "metrics": [
        "RMSE",
        "MAE",
        "Accuracy",
        "R2",
        "Explained_Variance"
    ],
    "arch": {
        "type": "A3TGCN",
        "args": {
            "node_features": 7,
            "hidden_dim": 64,
            "output_dim": 6,
            "adj_path": "data/temp/adj.csv",
            "batch_size": 32
        }
    },
    "data_loader": {
        "type": "TerminalFlightMixDataLoader",
        "args": {
            "data_dir": "data/temp",
            "batch_size": 32,
            "n_his": 12,
            "n_pred": 6,
            "is_continous": true,
            "dates_dist": [
                [
                    "20240609",
                    "20240618"
                ]
            ],
            "interval": 5,
            "normalizer": "std",
            "shuffle": true,
            "validation_split": 0.2,
            "training": true
        }
    },
    "optimizer": {
        "type": "Adam",
        "args": {
            "lr": 0.001
        }
    },
    "lr_scheduler": {
        "type": "StepLR",
        "args": {
            "step_size": 1000,
            "gamma": 0.1
        }
    },
    "trainer": {
        "epochs": 100,
        "save_dir": "LSaved/A3TGCN",
        "save_period": 10,
        "verbosity": 2,
        "early_stop": 20,
        "tensorboard": true
    }
}