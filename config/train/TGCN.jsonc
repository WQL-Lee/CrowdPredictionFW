{
    "name": "TGCN",
    "n_gpu": 1,
    "DEBUG": true,

    "arch": {
        "type": "TGCN",
        "args": {
            "adj_path": "data/temp/adj.csv",
            "num_nodes": 10,
            "hidden_dim": 256,
            "output_dim": 6
        }
    },
    "data_loader": {
        "type": "TerminalDataLoader",
        "args":{
            "data_dir": "data/temp",
            "batch_size": 32,
            "n_his": 12,
            "n_pred": 6,
            "is_continous": true,
            "dates_dist": [["20240609", "20240618"]],
            "interval":5,
            "normalizer": "std",
            "shuffle": true,
            "validation_split": 0.2,
            "training": true
        }
    },
    "optimizer": {
        "type": "Adam",
        "args":{
            "lr": 0.001
        }
    },
    "loss": "mse_with_regularizer_loss",
    "metrics": ["RMSE",
        "MAE",
        //"Accuracy",
        "R2",
        "Explained_Variance"
    ],
    "lr_scheduler": {
        "type": "StepLR",
        "args": {
            "step_size": 1000,
            "gamma": 0.1
        }
    },
    "trainer": {
        "epochs": 100,
        "save_dir": "LSaved/TGCN",
        "save_period": 10,
        "verbosity": 2,
        "early_stop": 20,
        "tensorboard": true
    },

    "result_info":{
        "is_saved": true,
        "saved_dir": "result/TGCN/train"
    }
}
